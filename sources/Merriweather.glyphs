";
name = Languagesystems;
},
{
code = "# Used by ccmp: splits off the ogonek and dot below of i, so its dot
# can be dropped when an accent goes above it (see ccmp_soft_dotted).
@SoftDottedTopAccents = [acutecomb brevecomb breveinvertedcomb caroncomb circumflexcomb commaturnedabovecomb dblgravecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb tildecomb];

lookup soft_dotted_decompose {
	sub iogonek by i ogonekcomb;
	sub idotbelow by i dotbelowcomb;
} soft_dotted_decompose;
";
name = SoftDotted;
}
);
